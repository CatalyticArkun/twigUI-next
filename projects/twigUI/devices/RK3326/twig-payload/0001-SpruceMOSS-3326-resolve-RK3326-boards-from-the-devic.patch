diff --git a/spruce/scripts/helperFunctions.sh b/spruce/scripts/helperFunctions.sh
index 52fa98817..d593dc938 100644
--- a/spruce/scripts/helperFunctions.sh
+++ b/spruce/scripts/helperFunctions.sh
@@ -57,7 +57,15 @@ case $INFO in
             export PLATFORM="Flip"
         fi
         ;;
-    *0xd04*) export PLATFORM="Pixel2" ;;        # RK3326
+    *0xd04*)                                    # RK3326 / RK3326S
+        # SpruceMOSS-3326's RK3326 image names its board in the device tree,
+        # in device-switch's group node (rk3326-device-group-twig.dtsi).
+        # Anything else - twigUI's own image included - is the GKD Pixel 2.
+        case "$(tr -d '\0' 2>/dev/null < /sys/firmware/devicetree/base/rocknix,device_switch/this)" in
+            g350) export PLATFORM="G350" ;;
+            *)    export PLATFORM="Pixel2" ;;
+        esac
+        ;;
     *0xd03*)                                    # H700
         export SPRUCE_BASEOS=1
         BASEOS_TARGET=$(sed -n 's/^BASEOS_TARGET=//p' /etc/baseos-release 2>/dev/null)
@@ -106,6 +114,11 @@ device_names() {
         SmartProS)        echo "TRIMUI_SMART_PRO_S" ;;
         Flip)             echo "MIYOO_FLIP" ;;
         Pixel2)           echo "GKD_PIXEL2" ;;
+        # SpruceMOSS-3326 boards run the Pixel 2's twig userspace and the
+        # emulators twig builds for it, so they answer to its name as their
+        # family token (the ANBERNIC_RGXX pattern) and need no config edits.
+        G350)             echo "BATLEXP_G350";  echo "GKD_PIXEL2" ;;
+        XUMiniM)          echo "MAGICX_XU_MINI_M"; echo "GKD_PIXEL2" ;;
         RGB30)            echo "RGB30" ;;
         Miniloong)        echo "MINILOONG_POCKET1" ;;
         Zero28)           echo "MAGICX_ZERO28" ;;
diff --git a/spruce/scripts/network/timeFunctions.sh b/spruce/scripts/network/timeFunctions.sh
index b430fa5c9..f1bbc1109 100644
--- a/spruce/scripts/network/timeFunctions.sh
+++ b/spruce/scripts/network/timeFunctions.sh
@@ -298,7 +298,8 @@ sync_timezone_from_network() {
 	command -v jq >/dev/null 2>&1 || return 0
 	# The Pixel 2 keeps its zone in its own system layer (tz-data.service),
 	# which PyUI's shared-config path does not write. Left alone on purpose.
-	[ "$PLATFORM" = "Pixel2" ] && return 0
+	# The SpruceMOSS-3326 boards run the same twig system layer.
+	case "$PLATFORM" in Pixel2|G350|XUMiniM) return 0 ;; esac
 	if ! time_sync_is_enabled; then
 		log_message "Timezone: network sync turned off in Time Settings, leaving the zone alone" -v
 		return 0
