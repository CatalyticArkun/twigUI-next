--- /dev/null
+++ b/App/PyUI/main-ui/devices/sprucemoss/sprucemoss3326_device.py
@@ -0,0 +1,87 @@
+from pathlib import Path
+import glob
+import threading
+from audio.audio_player_delegate_sdl2 import AudioPlayerDelegateSdl2
+from controller.controller_inputs import ControllerInput
+from controller.key_state import KeyState
+from controller.key_watcher import KeyWatcher
+from controller.key_watcher_controller import DictKeyMappingProvider, KeyWatcherController
+from controller.key_watcher_controller_dataclasses import InputResult, KeyEvent
+from devices.gkd.gkd_device import GKDDevice
+from devices.gkd.gkd_pixel2 import GKDPixel2
+from devices.miyoo.miyoo_games_file_parser import MiyooGamesFileParser
+from devices.utils.file_watcher import FileWatcher
+from utils.py_ui_config import PyUiConfig
+
+# SpruceMOSS-3326 boards: the Pixel 2's twig userspace (NetworkManager WiFi
+# menu, SDL2 audio, 640x480 - sway rotates portrait panels) on ROCKNIX's
+# mainline device trees. A board class sets the class attributes below. Event
+# paths follow device-tree node names and are unverified on a running unit.
+VOLUME_EVENT_PATH = "/dev/input/by-path/platform-gpio-keys-vol-event"
+# mainline's rk8xx core names the power key rk805-pwrkey.<n>.auto
+POWER_EVENT_GLOB = "/dev/input/by-path/platform-ff180000.i2c-platform-rk805-pwrkey*-event"
+
+# Codes every board here shares with the Pixel 2; a board adds its menu key.
+COMMON_KEY_CODES = {
+    304: ControllerInput.B,
+    305: ControllerInput.A,
+    307: ControllerInput.X,
+    308: ControllerInput.Y,
+    310: ControllerInput.L1,
+    311: ControllerInput.R1,
+    312: ControllerInput.L2,
+    313: ControllerInput.R2,
+    314: ControllerInput.SELECT,
+    315: ControllerInput.START,
+    317: ControllerInput.L3,
+    318: ControllerInput.R3,
+    544: ControllerInput.DPAD_UP,
+    545: ControllerInput.DPAD_DOWN,
+    546: ControllerInput.DPAD_LEFT,
+    547: ControllerInput.DPAD_RIGHT,
+}
+
+
+class SpruceMoss3326Device(GKDPixel2):
+    SYSTEM_CONFIG = None        # /mnt/SDCARD/Saves/<board>-system.json
+    DEFAULT_CONFIG = None       # the shipped default beside the board class
+    JOYPAD_EVENT_PATH = None
+    MENU_KEY_CODE = None
+
+    def __init__(self, device_name, main_ui_mode, board_dir):
+        # GKDPixel2.__init__ names the Pixel 2's config file and event nodes, so
+        # this is that constructor with the board's, ending in GKDDevice's.
+        self.device_name = device_name
+        self.audio_player = AudioPlayerDelegateSdl2()
+        self._load_system_config(self.SYSTEM_CONFIG, Path(board_dir) / self.DEFAULT_CONFIG)
+
+        if(main_ui_mode):
+            self.miyoo_games_file_parser = MiyooGamesFileParser()
+            threading.Thread(target=self.monitor_wifi, daemon=True).start()
+            threading.Thread(target=self.startup_init, daemon=True).start()
+            self.config_watcher_thread, self.config_watcher_thread_stop_event = FileWatcher().start_file_watcher(
+                self.SYSTEM_CONFIG, self.on_system_config_changed, interval=0.2, repeat_trigger_for_mtime_granularity_issues=True)
+            if(PyUiConfig.enable_button_watchers()):
+                from controller.controller import Controller
+                self.volume_key_watcher = KeyWatcher(VOLUME_EVENT_PATH)
+                Controller.add_button_watcher(self.volume_key_watcher.poll_keyboard)
+                threading.Thread(target=self.volume_key_watcher.poll_keyboard, daemon=True).start()
+                power_nodes = sorted(glob.glob(POWER_EVENT_GLOB))
+                self.power_key_watcher = KeyWatcher(power_nodes[0] if power_nodes else "/dev/input/event0")
+                threading.Thread(target=self.power_key_watcher.poll_keyboard, daemon=True).start()
+
+        GKDDevice.__init__(self)
+
+    def get_controller_interface(self):
+        codes = dict(COMMON_KEY_CODES)
+        codes[self.MENU_KEY_CODE] = ControllerInput.MENU
+        key_mappings = {}
+        for code, controller_input in codes.items():
+            key_mappings[KeyEvent(1, code, 1)] = [InputResult(controller_input, KeyState.PRESS)]
+            key_mappings[KeyEvent(1, code, 0)] = [InputResult(controller_input, KeyState.RELEASE)]
+        return KeyWatcherController(event_path=self.JOYPAD_EVENT_PATH, mapping_provider=DictKeyMappingProvider(key_mappings))
+
+    def get_device_names(self):
+        # The Pixel 2's name is the twig RK3326 family token: these boards run
+        # the emulators twig builds for it (helperFunctions.sh device_names).
+        return [self.device_name, "GKD_PIXEL2"]
