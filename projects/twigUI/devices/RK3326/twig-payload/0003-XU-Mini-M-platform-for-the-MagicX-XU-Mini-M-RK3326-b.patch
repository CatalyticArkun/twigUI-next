+export SYSTEM_VOLUME_20="1.00"
+
+export SYSTEM_BRIGHTNESS_0="1"
+export SYSTEM_BRIGHTNESS_1="25"
+export SYSTEM_BRIGHTNESS_2="50"
+export SYSTEM_BRIGHTNESS_3="75"
+export SYSTEM_BRIGHTNESS_4="100"
