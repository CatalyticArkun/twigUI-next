+export SYSTEM_BRIGHTNESS_7="175"
+export SYSTEM_BRIGHTNESS_8="200"
+export SYSTEM_BRIGHTNESS_9="225"
+export SYSTEM_BRIGHTNESS_10="255"
+
+  #########################################
+#####   RetroArch Keys   #####
+  #########################################
+# twig's RetroArch reads pads through SDL's GameController layer (sdl2 driver),
+# so these are GameController indices - the same on every mapped pad; guide
+# is each board's menu key.
+RA_HOTKEY_LINE="input_enable_hotkey_btn"
+RA_SELECT_VAL="4"
+RA_START_VAL="6"
