diff --git a/spruce/scripts/platform/device_functions/SpruceMOSS3326Common.sh b/spruce/scripts/platform/device_functions/SpruceMOSS3326Common.sh
new file mode 100644
index 000000000..7eaaa9812
--- /dev/null
+++ b/spruce/scripts/platform/device_functions/SpruceMOSS3326Common.sh
@@ -0,0 +1,117 @@
+#!/bin/sh
+
+# Intended to be sourced by helperFunctions.sh but NOT anywhere else
+# It relies on functions inside helperFunctions.sh to operate properly
+
+# SpruceMOSS-3326 RK3326 boards (G350.sh and XUMiniM.sh source this). They run
+# twig's userspace - the same systemd services, PipeWire volume,
+# NetworkManager, sway, RTC-alarm sleep and sysfs backlight as the Pixel 2 - so
+# the Pixel 2's functions are the base and this file only replaces what names
+# Pixel 2 hardware. The paths it needs come from the board's cfg.
+. "/mnt/SDCARD/spruce/scripts/platform/device_functions/Pixel2.sh"
+
+get_config_path() {
+    echo "$SYSTEM_JSON"
+}
+
+get_spruce_ra_cfg_location() {
+    echo "/mnt/SDCARD/RetroArch/platform/retroarch-$PLATFORM.cfg"
+}
+
+device_init() {
+    sync_volume_level
+    disable_swap
+    set_loading_screen &
+    setup_network_services &
+    orient_boot_logo &
+}
+
+# One image serves landscape and portrait panels, and the initramfs draws
+# /flash/logo.bmp raw, before anything rotates. The image ships it landscape;
+# a board whose cfg sets PANEL_LOGO_ROTATION gets it turned once, the way the
+# Boot Logo app would write it for that board.
+orient_boot_logo() {
+    [ -n "$PANEL_LOGO_ROTATION" ] && [ "$PANEL_LOGO_ROTATION" != "0" ] || return 0
+    logo="/flash/logo.bmp"
+    [ -f "$logo" ] || return 0
+    [ "$(magick identify -format '%wx%h' "$logo" 2>/dev/null)" = "640x480" ] || return 0
+    mount -o remount,rw /flash || return 0
+    if magick "$logo" -alpha off -rotate "$PANEL_LOGO_ROTATION" "BMP3:$logo.new"; then
+        mv "$logo.new" "$logo"
+        log_message "boot logo turned $PANEL_LOGO_ROTATION degrees for this panel"
+    else
+        rm -f "$logo.new"
+    fi
+    sync
+    mount -o remount,ro /flash
+}
+
+set_event_arg() {
+    EVENT_ARG="-e $EVENT_PATH_READ_INPUTS_SPRUCE"
+}
+
+# The Pixel 2 has five LEDs that leds_manager.sh drives from cava; the G350 has
+# one blue GPIO LED and the XU Mini M a red charging and a green status one.
+# Starting leds_manager here would only keep cava running against LEDs that
+# are not there.
+enable_or_disable_rgb() {
+    killall -q cava 2>/dev/null
+    killall -q leds_manager.sh 2>/dev/null
+}
+
+launch_startup_watchdogs(){
+    launch_common_startup_watchdogs_v2 "true"
+    stop_running_watchdog /mnt/SDCARD/spruce/scripts/theme_watchdog.sh
+    /mnt/SDCARD/spruce/scripts/theme_watchdog.sh &
+    /mnt/SDCARD/spruce/scripts/enable_zram.sh &
+}
+
+# twig's L2+R2 toggle turns the d-pad into a stick because the Pixel 2 has
+# none. Both boards have two real sticks, so PPSSPP and ScummVM get the left
+# one and the toggle is left off (it would also withhold L2 and R2).
+enable_dpad_to_analog() {
+    return 0
+}
+
+# The mouse toggle (PICO-8) is still useful with sticks: same map as the
+# Pixel 2's, on this board's pad.
+enable_dpad_to_mouse() {
+    evsieve --input "$EVENT_PATH_READ_INPUTS_SPRUCE" \
+            --hook btn:tl2 btn:tr2 toggle \
+            --withhold btn:tl2 btn:tr2 \
+            --toggle "" @dpad @mouse \
+            --hook btn:dpad_left:1~2 send-key=key:left \
+            --hook btn:dpad_right:1~2 send-key=key:right \
+            --hook btn:dpad_up:1~2 send-key=key:up \
+            --hook btn:dpad_down:1~2 send-key=key:down \
+            --oscillate key:left key:right key:up key:down period=0.01 \
+            --map yield key:left:1@mouse rel:x:-2 \
+            --map yield key:right:1@mouse rel:x:2 \
+            --map yield key:up:1@mouse rel:y:-2 \
+            --map yield key:down:1@mouse rel:y:2 \
+            --map yield btn:tl:0~1@mouse btn:left \
+            --map yield btn:tr:0~1@mouse btn:right \
+            --output &
+}
+
+set_default_ra_hotkeys() {
+    RA_FILE="$(get_spruce_ra_cfg_location)"
+
+    log_message "Resetting RetroArch hotkeys to Spruce defaults."
+
+    # GameController indices (twig's RetroArch uses the sdl2 driver), so the
+    # values are the Pixel 2's: guide is each board's menu key.
+    update_ra_config_file_with_new_setting "$RA_FILE" \
+        "input_enable_hotkey_btn = \"5\"" \
+        "input_exit_emulator_btn = \"1\"" \
+        "input_fps_toggle_btn = \"3\"" \
+        "input_load_state_btn = \"9\"" \
+        "input_menu_toggle = \"escape\"" \
+        "input_menu_toggle_btn = \"2\"" \
+        "input_quit_gamepad_combo = \"4\"" \
+        "input_save_state_btn = \"10\"" \
+        "input_screenshot_btn = \"0\"" \
+        "input_shader_toggle_btn = \"11\"" \
+        "input_state_slot_decrease_btn = \"13\"" \
+        "input_state_slot_increase_btn = \"14\""
+}
