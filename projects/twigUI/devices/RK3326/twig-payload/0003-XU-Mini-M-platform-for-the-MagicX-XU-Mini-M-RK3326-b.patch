index 000000000..1689a0b33
--- /dev/null
+++ b/spruce/scripts/platform/SpruceMOSS3326Common.cfg
@@ -0,0 +1,202 @@
+#!/bin/sh
+# SpruceMOSS-3326 RK3326 boards: what they share. Sourced by each board's cfg
+# (G350.cfg, XUMiniM.cfg), which then sets its own identity, joypad node and
+# menu key.
+#
+# The RK3326 image runs ROCKNIX's mainline kernel and device trees under
+# twig's userspace, so everything about the userspace is the Pixel 2's
+# (Pixel2.cfg) and the SoC values are one image's. Values come from the device
+# trees and kernel config the image is built from; none has been read on a
+# running unit yet.
+
+  #################################
+#####   IDENTITY AND FIRMWARE   #####
+  #################################
+
+export FW_FILE=""
+export TARGET_FW_VERSION=""
+export REQ_MB_TO_UPDATE_FW=1280
+export SYSTEM_PATH="/mnt/SDCARD/gkd"
+# Two card slots, and spruce may live on either (start_spruce.sh: SD1 is the
+# built card's own FAT32 partition, SD2 a separate card that wins when
+# present), so the device is whatever is mounted at /mnt/SDCARD. The fallback
+# is SD1 when booted from the sdmmc slot, which the device tree calls mmc1.
+export SD_DEV="$(awk '$2 == "/mnt/SDCARD" {print $1; exit}' /proc/mounts 2>/dev/null)"
+[ -n "$SD_DEV" ] || export SD_DEV="/dev/mmcblk1p3"
+export SD_MOUNTPOINT="/mnt/SDCARD/"
+export PLATFORM_ARCHITECTURE="aarch64"
+
+
+  ###################################
+#####   DISPLAY CHARACTERISTICS   #####
+  ###################################
+
+export DISPLAY_TEXT_ELF_WIDTH="600"
+export DISPLAY_WIDTH="640"
+export DISPLAY_HEIGHT="480"
+export DISPLAY_ROTATION="0"
+export DISPLAY_ASPECT_RATIO="4:3"
+
+  ########################
+#####   CPU SETTINGS   #####
+  ########################
+
+# Governors built (linux.aarch64.conf): performance (default) powersave
+# ondemand schedutil - no conservative, so powersave mode's governor write is
+# refused and min = max below does the pinning instead.
+# OPPs (px30.dtsi as trimmed by the profile's rk3326.dtsi): 1008000 1296000,
+# and 1416000 as turbo-mode.
+export DEVICE_MIN_CORES_ONLINE=0
+export DEVICE_MAX_CORES_ONLINE=0123
+export DEVICE_POWERSAVE_LOW_FREQ=1008000
+export DEVICE_POWERSAVE_HIGH_FREQ=1008000
+
+export CPU_SMART_CORES_ONLINE=0123
+export CPU_SMART_GOVENOR="ondemand"
+export CPU_SMART_MIN_FREQ=1008000
+export CPU_SMART_MAX_FREQ=1296000
+export CPU_PERF_MAX_FREQ=1296000
+export CPU_OVERCLOCK_MAX_FREQ=1416000
+export CONSERVATIVE_POLICY_DIR=/sys/devices/system/cpu/cpu0/cpufreq/conservative
+
+# simple_ondemand performance powersave userspace passive
+# rk3326.dtsi leaves the GPU a single OPP, 560000000, so every mode lands there.
+export GPU_GOVENOR_DIR="/sys/class/devfreq/ff400000.gpu"
+export GPU_SMART_GOVERNOR="simple_ondemand"
+export GPU_SMART_MAX_FREQ="560000000"
+export GPU_PERFORMANCE_GOVERNOR="simple_ondemand"
+export GPU_PERFORMANCE_MAX_FREQ="560000000"
+export GPU_OVERCLOCK_GOVERNOR="performance"
+export GPU_OVERCLOCK_MAX_FREQ="560000000"
+
+
+  ##################################################
+#####   OTHER HARDWARE FEATURES AND INTERFACES   #####
+  ##################################################
+
+export BATTERY="/sys/class/power_supply/battery"   # rk817_charger.c names its battery supply "battery"
+export LED_PATH="not applicable"
+export DEVICE_BRIGHTNESS_PATH="/sys/class/backlight/backlight/brightness"
+export RUMBLE_GPIO=""
+export WPA_SUPPLICANT_FILE=""
+export DEVICE_NUM_ANALOG_STICKS=2
+
+  ###############################################
+#####   SOFTWARE CHARACTERISTICS AND QUIRKS   #####
+  ###############################################
+
+export PATH=/mnt/SDCARD/spruce/bin64:/usr/bin:/usr/sbin:/bin:/sbin
+export LD_LIBRARY_PATH="/usr/lib:/lib:/usr/lib/compat"
+export SPRUCE_ETC_DIR="/mnt/SDCARD/gkd/etc"
+export DEVICE_PYTHON3_PATH="/usr/bin/python"
+export DEVICE_SUPPORTS_PORTMASTER="true"
+export PORTS_LD_LIBRARY_PATH="/usr/lib:/lib:/usr/lib/compat"
+export DEVICE_CAN_USE_EXTERNAL_CONTROLLER="false"
+export DEVICE_USES_64_BIT_RA="true"
+export RA_BIN="ra64.pixel2"
+export PSP_BIN="PPSSPPSDL_Pixel2"
+export MUPEN_DIR="mupen64plus"
+export PCSX_BIN="pcsx_64"
+
+  ######################################
+#####   KEY CODES AND INPUT EVENTS   #####
+  ######################################
+
+# The board cfg sets the joypad node (EVENT_PATH_READ_INPUTS_SPRUCE and the
+# two taken from it) and B_MENU. By-path names follow device-tree node names:
+# the volume keys are gpio-keys-vol on both boards. The rk817 power key sits on
+# i2c0 (ff180000), but mainline's rk8xx core registers its cells with
+# PLATFORM_DEVID_AUTO, so its node is rk805-pwrkey.<n>.auto and has to be
+# found. UNVERIFIED on a running unit.
+export EVENT_PATH_VOLUME="/dev/input/by-path/platform-gpio-keys-vol-event"
+EVENT_PATH_POWER="$(ls /dev/input/by-path/platform-ff180000.i2c-platform-rk805-pwrkey*-event 2>/dev/null | head -n 1)"
+export EVENT_PATH_POWER="${EVENT_PATH_POWER:-/dev/input/event0}"
+
+export B_POWER="1 116"
+
+export B_LEFT="1 546"
+export B_RIGHT="1 547"
+export B_UP="1 544"
+export B_DOWN="1 545"
+
+export B_A="1 305"
+export B_B="1 304"
+export B_X="1 307"
+export B_Y="1 308"
+
+export B_L1="1 310"
+export B_L2="1 312"
+export B_R1="1 311"
+export B_R2="1 313"
+
+export B_L3="1 317" # also logs left fnkey stuff
+export B_R3="1 318" # also logs right fnkey stuff
+
+export B_START="1 315"
+export B_START_2="enter_pressed" # only registers 0 on release, no 1.
+export B_SELECT="1 314"
+export B_SELECT_2="rctrl_pressed" # registers both 1 and 0
+
+export B_VOLUP="1 115" # has actual key codes like the buttons
+export B_VOLUP_2="volume up" # only registers 0 on release, no 1.
+export B_VOLDOWN="1 114" # has actual key codes like the buttons
+export B_VOLDOWN_2="volume down" # only registers 0 on release, no 1.
+
+export STICK_LEFT="3 0 -32767" # negative for left
+export STICK_RIGHT="3 0 32767" # positive for right
+export STICK_UP="3 1 -32767"   # negative for up
+export STICK_DOWN="3 1 32767"  # positive for down
+
+export STICK_LEFT_2="3 3 -32767" # ABS_RX, negative for left
+export STICK_RIGHT_2="3 3 32767" # ABS_RX, positive for right
+export STICK_UP_2="3 4 -32767"   # ABS_RY, negative for up
+export STICK_DOWN_2="3 4 32767"  # ABS_RY, positive for down
+
+  #########################################
+#####   VOLUME AND BRIGHTNESS MAPPING   #####
+  #########################################
+
+export SYSTEM_VOLUME_0="0.00"
+export SYSTEM_VOLUME_1="0.05"
+export SYSTEM_VOLUME_2="0.10"
+export SYSTEM_VOLUME_3="0.15"
+export SYSTEM_VOLUME_4="0.20"
