+#!/bin/sh
+# MagicX XU Mini M (SpruceMOSS-3326, rk3326-magicx-xu-mini-m.dts over the XU10's)
+
+. /mnt/SDCARD/spruce/scripts/platform/SpruceMOSS3326Common.cfg
+
+export BRAND="MagicX"
+export SYSTEM_JSON="/mnt/SDCARD/Saves/magicx-xu-mini-m-system.json"
+
+# xu10-joypad (in the kernel, CONFIG_JOYSTICK_XU10), reporting as "XU Mini M
+# Gamepad" c3b0:0200. The Mini M's tree re-wires A/B/X/Y so the printed A
+# sends BTN_EAST, as on the Pixel 2 - the codes above hold - and its menu key
+# is BTN_TRIGGER_HAPPY1 (704), the Pixel 2's too. It has no BTN_MODE.
+# twig's gamecontrollerdb already maps it by label, so unlike the G350 it
+# needs no SDL override.
+export EVENT_PATH_READ_INPUTS_SPRUCE="/dev/input/by-path/platform-xu10-joypad-event-joystick"
+export EVENT_PATH_SEND_TO_DRASTIC="$EVENT_PATH_READ_INPUTS_SPRUCE"
+export EVENT_PATH_SEND_TO_RA_AND_PPSSPP="$EVENT_PATH_READ_INPUTS_SPRUCE"
+export B_MENU="1 704"
+
+# The panel is portrait (480x640) with rotation = <90> in the device tree:
+# twig's sway start-up turns the UI from fbcon/rotate, but the initramfs
+# draws /flash/logo.bmp raw. SpruceMOSS3326Common.sh turns the image's
+# landscape logo by this much, once.
+export PANEL_LOGO_ROTATION="90"
